{
  "name": "slopmachine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "zod": "^4.6.7"
  }
}
